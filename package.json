{
	"name": "aparavi-file-investigator",
	"version": "1.0.0",
	"description": "An LLM powered chat assistant to investigate large complex datasets.",
	"private": true,
	"workspaces": [
		"packages/*"
	],
	"scripts": {
		"start": "pnpm build && concurrently -n \"backend,frontend\" -c \"blue,green\" \"pnpm --filter @aparavi/express-app start\" \"pnpm --filter @aparavi/client preview\"",
		"dev": "concurrently -n \"backend,frontend\" -c \"blue,green\" \"pnpm --filter @aparavi/express-app dev\" \"pnpm --filter @aparavi/client dev\"",
		"dev:client": "pnpm --filter @aparavi/client dev",
		"dev:app": "pnpm --filter @aparavi/express-app dev",
		"build": "pnpm --filter @aparavi/chat-core build && pnpm --filter @aparavi/express-app build && pnpm --filter @aparavi/client build",
		"build:chat-core": "pnpm --filter @aparavi/chat-core build",
		"install:all": "pnpm install",
		"test": "pnpm --filter @aparavi/chat-core test && pnpm --filter @aparavi/express-app test && pnpm --filter @aparavi/client test",
		"test:chat-core": "pnpm --filter @aparavi/chat-core test",
		"test:app": "pnpm --filter @aparavi/express-app test",
		"test:client": "pnpm --filter @aparavi/client test",
		"test:watch": "concurrently -n \"chat-core,app,client\" -c \"yellow,blue,green\" \"pnpm --filter @aparavi/chat-core test:watch\" \"pnpm --filter @aparavi/express-app test:watch\" \"pnpm --filter @aparavi/client test\"",
		"lint": "eslint . --ext .ts,.tsx,.js,.jsx",
		"lint:fix": "eslint . --ext .ts,.tsx,.js,.jsx --fix"
	},
	"devDependencies": {
		"@typescript-eslint/eslint-plugin": "^6.21.0",
		"@typescript-eslint/parser": "^6.21.0",
		"concurrently": "^8.2.2",
		"eslint": "^8.56.0",
		"eslint-plugin-react": "^7.33.2",
		"eslint-plugin-react-hooks": "^4.6.0"
	},
	"pnpm": {
		"overrides": {
			"baseline-browser-mapping": ">=2.9.15"
		}
	},
	"engines": {
		"node": ">=18.0.0",
		"pnpm": ">=8.0.0"
	},
	"dependencies": {
		"cors": "^2.8.5",
		"eslint-plugin-import": "^2.32.0",
		"lucide-react": "^0.555.0",
		"moment": "^2.30.1"
	},
	"contributors": [
		{
			"name": "Joshua D. Phillips",
			"email": "josh.phillips@aparavi.com",
			"url": "https://github.com/joshuadarron"
		}
	]
}
