# Server Configuration
PORT=3001
NODE_ENV=development

# Backend Type: 'express' or 'lambda'
# If 'lambda', the Express server will not start
BACKEND_TYPE=express

# Frontend Configuration
FRONTEND_URL=http://localhost:3000

# Webhook Configuration (Legacy - for backward compatibility)
# Use this for a single default pipeline
WEBHOOK_BASE_URL=https://your-aparavi-instance.com/api/webhook/endpoint
WEBHOOK_AUTHORIZATION_KEY=your-authorization-key-here
WEBHOOK_TOKEN=your-webhook-token-here

# Pipeline Configurations (NEW - supports multiple datasets)
# Format: PIPELINE_{DATASET_ID}_{PROPERTY}
# Dataset IDs should match the keys in client/src/translations/en.tsx (e.g., 'epstein', 'jfk', 'ufo')

# Epstein Files Pipeline
PIPELINE_EPSTEIN_BASE_URL=https://epstein-pipeline.aparavi.com/api/webhook/endpoint
PIPELINE_EPSTEIN_AUTHORIZATION_KEY=epstein-authorization-key-here
PIPELINE_EPSTEIN_TOKEN=epstein-webhook-token-here

# JFK Files Pipeline
PIPELINE_JFK_BASE_URL=https://jfk-pipeline.aparavi.com/api/webhook/endpoint
PIPELINE_JFK_AUTHORIZATION_KEY=jfk-authorization-key-here
PIPELINE_JFK_TOKEN=jfk-webhook-token-here

# UFO Files Pipeline
PIPELINE_UFO_BASE_URL=https://ufo-pipeline.aparavi.com/api/webhook/endpoint
PIPELINE_UFO_AUTHORIZATION_KEY=ufo-authorization-key-here
PIPELINE_UFO_TOKEN=ufo-webhook-token-here

# Security (optional)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Logging
LOG_LEVEL=info